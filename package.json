{
  "name": "llms-robot-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous robot combat simulator, controller sandbox and replay viewer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nigrosimone/llms-robot-arena.git"
  },
  "homepage": "https://github.com/nigrosimone/llms-robot-arena#readme",
  "bugs": {
    "url": "https://github.com/nigrosimone/llms-robot-arena/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node packages/viewer/serve.js",
    "viewer": "node packages/viewer/serve.js",
    "test": "node --test tests/*.test.js",
    "e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "gate": "node packages/runtime/gate-cli.js",
    "standings": "node scripts/standings.mjs",
    "verify": "node scripts/verify.mjs",
    "generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "0.31.0",
    "@noble/hashes": "1.8.0",
    "acorn": "8.18.0",
    "mp4-muxer": "^5.2.2",
    "quickjs-emscripten": "0.31.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
